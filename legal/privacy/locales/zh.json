          "rows": [
            [
              "<strong>Supabase</strong>",
              "数据库、身份验证与文件存储",
              "欧盟（AWS eu-west-1，爱尔兰）",
              "在欧盟境内处理"
            ],
            [
              "<strong>Google Cloud / Firebase</strong>",
              "云函数（europe-west1，比利时）、推送通知、App Check 保护、崩溃报告",
              "欧盟/美国",
              "标准合同条款（SCC）及欧盟-美国数据隐私框架（DPF）"
            ],
            [
              "<strong>OpenAI</strong>",
              "收据数据提取、AI 助手与报告",
              "美国",
              "SCC / DPF；默认不用于模型训练"
            ],
            [
              "<strong>Google AdMob</strong>",
              "免费方案中的广告",
              "欧盟/美国",
              "SCC / DPF；UMP/TCF 同意机制"
            ],
            [
              "<strong>RevenueCat</strong>",
              "订阅管理",
              "美国",
              "SCC / DPF"
            ],
            [
              "<strong>Google Play / Stripe</strong>",
              "支付处理",
              "欧盟/美国",
              "SCC / DPF；我们绝不会看到您的完整银行卡数据"
